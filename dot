#!/usr/bin/env python3
"""dot: your setup, the same on every machine.

One stdlib-only file. The setup folder (~/.dot, or DOT_HOME) is a git repo holding dot.toml and the
sources it names. Every command derives one plan (write, mkdir, delete) from the config, the
sources, the live files and .state/written.json; `status` prints that plan, `apply` carries it out,
and `sync` (run by a timer) fast-forwards the folder from its remote, pushes when ahead, and applies.
"""
import sys

if sys.version_info < (3, 11):
    sys.stderr.write(f"dot: dot needs Python 3.11+ (found {sys.version.split()[0]} at {sys.executable})\n")
    sys.exit(2)

import difflib, fcntl, fnmatch, hashlib, json, os, plistlib, re, shutil, socket, stat, subprocess, tempfile, time, tomllib
from pathlib import Path

HOME = os.path.expanduser("~")
DOT = os.path.abspath(os.path.expanduser(os.environ.get("DOT_HOME") or "~/.dot"))
STATE = os.path.join(DOT, ".state")
PROGRAM = os.path.realpath(__file__)
EXAMPLE = os.path.join(os.path.dirname(PROGRAM), "example")
MAPPING_KEYS = {"to", "mirror", "exclude", "machines"}
LABELS = {"+": "new", "~": "changed", "-": "removed", "!": "edited here", "?": "extra"}
USAGE = """dot: your setup, the same on every machine.

usage:
  dot [status [path]]       show what apply would do; with a path, a diff for it
                            (+ new, ~ changed, - removed, ! edited here, ? extra)
  dot apply [-n] [--force]  write the plan; -n only prints it; --force overwrites files edited here
  dot sync                  pull, push when ahead and push is on, then apply (the timer runs this)
  dot take <path>           copy a live file or folder back to its source in the setup
  dot init [remote]         create the setup from the example, or clone it from a git remote
  dot install [--remove]    run dot sync every 15 minutes on this machine (or stop it)
  dot help                  this text and a summary of the setup

The setup is ~/.dot (or DOT_HOME): dot.toml plus the sources it names. The machine name is
hostname -s (or DOT_MACHINE). Edit sources there and commit; never edit the destinations."""


class Fail(Exception):
    """A user-facing error: one line per problem, printed with a `dot:` prefix, exiting with `code`."""

    def __init__(self, msg, code=2):
        super().__init__(msg)
        self.code = code


def show(p):
    """`p` with the home folder written as ~, for messages."""
    return "~" + p[len(HOME):] if p == HOME or p.startswith(HOME + os.sep) else p


def machine_name():
    """This machine's name: DOT_MACHINE, else the short host name."""
    return os.environ.get("DOT_MACHINE") or socket.gethostname().split(".")[0]


def render(text, values, where):
    """Replace each {{name}} in `text` with values[name]; an undefined name raises Fail naming `where`."""
    def sub(m):
        if m[1] not in values:
            raise Fail(f'{where}: undefined name "{m[1]}"')
        return values[m[1]]
    return re.sub(r"\{\{\s*(\w+)\s*\}\}", sub, text)


def under(p, top):
    """True when absolute path `p` lies strictly inside folder `top` (both normalized; works for /)."""
    return p != top and os.path.commonpath([p, top]) == top


def excluded(rel, patterns):
    """True when any segment of the relative path `rel` matches any glob in `patterns`."""
    return any(fnmatch.fnmatchcase(seg, p) for seg in rel.split(os.sep) for p in patterns)


def load():
    """Parse dot.toml into a config dict and validate it for every machine; raises Fail (exit 2),
    naming the field, for a wrong type as well as a bad value."""
    def need(ok, what):
        if not ok:
            raise Fail(f"dot.toml: {what}")
    strs = lambda x: isinstance(x, list) and all(isinstance(v, str) for v in x)
    scalars = lambda t: isinstance(t, dict) and all(isinstance(v, (str, int, float)) and not isinstance(v, bool)
                                                    for v in t.values())
    path = os.path.join(DOT, "dot.toml")
    if not os.path.isfile(path):
        raise Fail(f"no setup at {show(DOT)} (run dot init)")
    try:
        with open(path, "rb") as f:
            raw = tomllib.load(f)
    except tomllib.TOMLDecodeError as e:
        raise Fail(f"dot.toml: {e}")
    version, sync_ = raw.get("version", 1), raw.get("sync", {})
    need(isinstance(version, int) and not isinstance(version, bool), "version must be a whole number")
    need(version <= 1, f"version {version} is newer than this dot; update dot")
    need(strs(raw.get("exclude", [])), "exclude must be a list of strings")
    need(isinstance(sync_, dict) and isinstance(sync_.get("push", False), bool), "[sync] push must be true or false")
    need(scalars(raw.get("values", {})), "[values] must be strings or numbers")
    need(isinstance(raw.get("machine", {}), dict), "machine must be a table of [machine.<name>] tables")
    for m, t in raw.get("machine", {}).items():
        need(scalars(t), f"[machine.{m}] values must be strings or numbers")
    cfg = {"exclude": list(raw.get("exclude", [])), "push": bool(raw.get("sync", {}).get("push", False)),
           "values": {k: str(v) for k, v in raw.get("values", {}).items()},
           "machines": {m: {k: str(v) for k, v in t.items()} for m, t in raw.get("machine", {}).items()},
           "maps": []}
    for section in ("templates", "files"):
        need(isinstance(raw.get(section, {}), dict), f"[{section}] must be a table")
        for src, val in raw.get(section, {}).items():
            label = f'[{section}] "{src}"'
            mp = {"label": label, "src": src, "template": section == "templates", "mirror": True,
                  "exclude": [], "machines": None}
            if isinstance(val, dict):
                for k in val:
                    if k not in MAPPING_KEYS:
                        raise Fail(f'dot.toml: {label}: unknown key "{k}"')
                need(isinstance(val.get("mirror", True), bool), f"{label}: mirror must be true or false")
                need(strs(val.get("exclude", [])), f"{label}: exclude must be a list of strings")
                need(val.get("machines") is None or strs(val["machines"]), f"{label}: machines must be a list of strings")
                mp.update(mirror=val.get("mirror", True), exclude=list(val.get("exclude", [])),
                          machines=val.get("machines"))
                val = val.get("to")
            mp["to"] = [val] if isinstance(val, str) else val
            if not isinstance(mp["to"], list) or not mp["to"] or not all(isinstance(t, str) for t in mp["to"]):
                raise Fail(f"dot.toml: {label}: destination must be a string or a list of strings")
            cfg["maps"].append(mp)
    validate(cfg)
    return cfg


def values_for(cfg, machine):
    """The values on `machine`: base values, that machine's overrides, and `machine` itself."""
    return {**cfg["values"], **cfg["machines"].get(machine, {}), "machine": machine}


def resolve(cfg, machine):
    """The mappings that apply on `machine`, as (mapping, absolute source, [absolute destinations])."""
    values, out = values_for(cfg, machine), []
    for mp in cfg["maps"]:
        if mp["machines"] is not None and machine not in mp["machines"]:
            continue
        where = f"dot.toml: {mp['label']} on {machine}"
        src = os.path.join(DOT, render(mp["src"], values, where))
        dests = [os.path.normpath(os.path.expanduser(render(t, values, where))) for t in mp["to"]]
        for d in dests:
            if not os.path.isabs(d):
                raise Fail(f"{where}: destination {d} must be absolute or start with ~")
        out.append((mp, src, dests))
    return out


def validate(cfg):
    """Check every known machine for undefined names, missing sources, two mappings writing one
    destination, and one destination inside another. Destinations are compared with their parent
    folders resolved, so a symlinked parent cannot hide a clash. Raises one Fail listing every problem."""
    machines = {machine_name(), *cfg["machines"]} | {m for mp in cfg["maps"] for m in mp["machines"] or []}
    errors = []
    for m in sorted(machines):
        try:
            maps = resolve(cfg, m)
        except Fail as e:
            errors.append(str(e))
            continue
        owner = {}
        for mp, src, dests in maps:
            where = f"dot.toml: {mp['label']} on {m}"
            if not os.path.lexists(src):
                errors.append(f"{where}: missing source {show(src)}")
            elif mp["template"] and not os.path.isfile(src):
                errors.append(f"{where}: a template must be a file")
            elif mp["template"]:
                try:
                    render(Path(src).read_text(), values_for(cfg, m), f"{show(src)} on {m}")
                except Fail as e:
                    errors.append(str(e))
            for d in dests:
                real = os.path.join(os.path.realpath(os.path.dirname(d)), os.path.basename(d))
                if real in owner:
                    errors.append(f"{where}: {show(d)} is also written by {owner[real][0]}")
                owner[real] = (mp["label"], d)
        for a, (la, da) in owner.items():
            for b, (lb, db) in owner.items():
                if under(b, a):
                    errors.append(f"dot.toml: {lb} on {m}: {show(db)} is inside {show(da)} from {la}")
    if errors:
        raise Fail("\n".join(dict.fromkeys(errors)))


def sig_link(target):
    """The recorded hash of a symlink pointing at `target`."""
    return hashlib.sha256(b"link:" + target.encode()).hexdigest()


def live_sig(p):
    """The hash of what is at `p` now: a file's bytes, a symlink's target, "dir", or None if absent."""
    if os.path.islink(p):
        return sig_link(os.readlink(p))
    if os.path.isdir(p):
        return "dir"
    return hashlib.sha256(Path(p).read_bytes()).hexdigest() if os.path.isfile(p) else None


def want_of(src, data=None):
    """What putting source `src` (or rendered `data` with src's mode) at a destination means:
    {"kind": file|link|dir, "data", "mode", "sig", "src"}."""
    if os.path.islink(src):
        t = os.readlink(src)
        return {"kind": "link", "data": t, "mode": 0, "sig": sig_link(t), "src": src}
    mode = stat.S_IMODE(os.stat(src).st_mode)
    if os.path.isdir(src):
        return {"kind": "dir", "data": b"", "mode": mode, "sig": "dir", "src": src}
    data = Path(src).read_bytes() if data is None else data
    return {"kind": "file", "data": data, "mode": mode, "sig": hashlib.sha256(data).hexdigest(), "src": src}


def wants(cfg):
    """What this machine's setup produces: ({destination: want}, [(root, mirror, excludes, source)])
    where the roots are the destinations of folder mappings."""
    out, roots, machine = {}, [], machine_name()
    for mp, src, dests in resolve(cfg, machine):
        excl = cfg["exclude"] + mp["exclude"]
        if mp["template"]:
            text = render(Path(src).read_text(), values_for(cfg, machine), show(src))
            items = [(".", want_of(src, text.encode()))]
        elif os.path.isdir(src) and not os.path.islink(src):
            items = []
            for d, dirs, files in os.walk(src):
                rel = os.path.relpath(d, src)
                items.append((rel, want_of(d)))
                links = [x for x in dirs if os.path.islink(os.path.join(d, x))]
                dirs[:] = sorted(x for x in dirs if x not in links and not excluded(os.path.join(rel, x), excl))
                items += [(os.path.join(rel, x), want_of(os.path.join(d, x))) for x in files + links
                          if not excluded(os.path.join(rel, x), excl)]
            roots += [(dest, mp["mirror"], excl, src) for dest in dests]
        else:
            items = [(".", want_of(src))]
        for dest in dests:
            for rel, w in items:
                out[os.path.normpath(os.path.join(dest, rel))] = {**w, "template": mp["template"]}
    return out, roots


def via_link(p, tops):
    """True when a folder from the destination root holding `p` (inclusive) down to `p`'s parent is a
    symlink: what `p` names then lives outside the destination, so dot must not touch it."""
    top = max((t for t in tops if under(p, t)), key=len, default=None)
    d = os.path.dirname(p)
    while top and (d == top or under(d, top)):
        if os.path.islink(d):
            return True
        d = os.path.dirname(d)
    return False


def plan(cfg, written):
    """The actions that bring the live files to the setup, as (mark, path, op, want) with mark one of
    + ~ - ! ? and op "write", "mkdir", "delete" or None. Deletions come first, so a folder the setup
    turned into a file is emptied before it is replaced; excluded files are never deleted. A path
    reached through a symlink inside a destination root counts as absent. "~" replaces what dot
    wrote (or a folder inside a destination root); "!" (edited here) needs --force; "?" is
    informational. Returns (actions, wants, roots)."""
    want, roots = wants(cfg)
    tops = [r for r, *_ in roots] + [p for p, s in written.items() if s == "dir"]
    acts = []
    for p, s in sorted(written.items()):
        root = next((r for r in roots if under(p, r[0])), None)
        if p in want or s == "dir" or via_link(p, tops) or root and excluded(os.path.relpath(p, root[0]), root[2]):
            continue
        live = live_sig(p)
        if live is not None:
            acts.append(("-" if live == s else "!", p, "delete", None))
    for root, mirror, excl, _ in roots:
        if not os.path.isdir(root) or os.path.islink(root):
            continue
        for d, dirs, files in os.walk(root):
            links = [x for x in dirs if os.path.islink(os.path.join(d, x))]
            for x in sorted(files + links):
                p = os.path.join(d, x)
                if p not in want and p not in written and not excluded(os.path.relpath(p, root), excl):
                    acts.append(("-", p, "delete", None) if mirror else ("?", p, None, None))
            dirs[:] = sorted(x for x in dirs if x not in links and not excluded(os.path.relpath(os.path.join(d, x), root), excl))
    for p in sorted(want):
        w, live = want[p], None if via_link(p, tops) else live_sig(p)
        if live == w["sig"]:
            continue
        replace = live == written.get(p) or live == "dir" and any(under(p, r) for r, *_ in roots)
        acts.append(("+" if live is None else "~" if replace else "!", p, "mkdir" if w["kind"] == "dir" else "write", w))
    return acts, want, roots


def read_written():
    """This machine's record of what dot wrote: {absolute path: sha256, or "dir" for a folder root}."""
    try:
        return json.loads(Path(STATE, "written.json").read_text())
    except FileNotFoundError:
        return {}


def write(p, w):
    """Atomically put want `w` at `p` (temp file in the same folder, fsync, os.replace).
    An existing file keeps its permission bits; a new one takes w["mode"]."""
    parent = os.path.dirname(p)
    os.makedirs(parent, exist_ok=True)
    if w["kind"] == "link":
        tmp = os.path.join(parent, f".dot-{os.getpid()}.tmp")
        os.symlink(w["data"], tmp)
        os.replace(tmp, p)
        return
    mode = stat.S_IMODE(os.stat(p).st_mode) if os.path.isfile(p) and not os.path.islink(p) else w["mode"]
    fd, tmp = tempfile.mkstemp(dir=parent, prefix=".dot-")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(w["data"])
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, p)
    except BaseException:
        os.unlink(tmp)
        raise


def prune(p, tops, dropped, want):
    """Remove folders left empty above deleted `p`, up to the destination root that holds it
    (the root itself only when the setup dropped it); never a folder the setup still wants, nor
    anything above that root."""
    top = max((t for t in tops if under(p, t)), key=len, default=None)
    d = os.path.dirname(p)
    while top and (under(d, top) or d == top and top in dropped) and want.get(d, {}).get("kind") != "dir":
        try:
            os.rmdir(d)
        except OSError:
            return
        d = os.path.dirname(d)


def apply(cfg, force=False):
    """Carry out the plan and update written.json. An "!" action is refused unless `force`, and so is
    every action beneath it or replacing a folder that holds it. A new folder takes its source's
    permission bits (plus owner rwx, so dot can manage it); an existing one keeps its own. A folder
    replaced by a file must be empty once the plan's deletions ran. Returns (actions done, paths refused)."""
    written = read_written()
    acts, want, roots = plan(cfg, written)
    tops = [r for r, *_ in roots]
    dropped = [p for p, s in written.items() if s == "dir" and p not in want]
    done, refused = [], []
    try:
        for mark, p, op, w in acts:
            if op is None or any(under(p, r) or under(r, p) for r, _ in refused):
                continue
            if mark == "!" and not force:
                refused.append((p, op))
                continue
            try:
                if op != "write" and (os.path.islink(p) or os.path.lexists(p) and not os.path.isdir(p)):
                    os.remove(p)
                elif op == "write" and os.path.isdir(p) and not os.path.islink(p):
                    os.rmdir(p)
                if op == "write":
                    write(p, w)
                elif op == "mkdir" and not os.path.isdir(p):
                    os.makedirs(p)
                    os.chmod(p, w["mode"] | stat.S_IRWXU)
                elif op == "delete":
                    written.pop(p, None)
                    prune(p, tops + dropped, dropped, want)
            except OSError as e:
                raise Fail(f"cannot {op} {show(p)}: {e.strerror}")
            done.append((mark, p, op, w))
        for d in dropped:
            try:
                os.rmdir(d)
            except OSError:
                pass
            if not os.path.isdir(d):
                written.pop(d)
        for p in [p for p in written if p not in want and written[p] != "dir" and not os.path.lexists(p)]:
            written.pop(p)
        for p, w in want.items():
            if (w["kind"] != "dir" or p in tops) and live_sig(p) == w["sig"]:
                written[p] = w["sig"]
            elif w["kind"] == "dir" and p not in tops:
                written.pop(p, None)
    finally:
        os.makedirs(STATE, exist_ok=True)
        write(os.path.join(STATE, "written.json"),
              {"kind": "file", "data": json.dumps(written, indent=1, sort_keys=True).encode(), "mode": 0o644})
    return done, refused


def edited_note(p, op):
    """How to resolve a file edited here: take it back into the setup, or force the plan."""
    if op == "delete":
        return f"edited here: {show(p)} (no longer in the setup; delete it, or dot apply --force)"
    return f"edited here: {show(p)} (dot take {show(p)}, or dot apply --force)"


def print_plan(acts):
    """Print actions one per line: mark, label, path (folders end in /)."""
    for mark, p, op, w in acts:
        print(f"{mark} {LABELS[mark]:<11} {show(p)}{'/' if op == 'mkdir' else ''}")


def diff(p, w, reverse=False):
    """Print a unified diff from the live file at `p` to want `w` (None means deleted); reversed for take.
    When either side is not text, print one line saying the binary files differ."""
    live = (f"-> {os.readlink(p)}\n".encode() if os.path.islink(p) else
            Path(p).read_bytes() if os.path.isfile(p) else b"")
    new = b"" if w is None else f"-> {w['data']}\n".encode() if w["kind"] == "link" else w["data"]
    a, b = (("live", live), ("dot", new))[::-1 if reverse else 1]
    try:
        lines = [x.decode().splitlines(keepends=True) for _, x in (a, b)]
    except UnicodeDecodeError:
        print(f"binary files {a[0]} {show(p)} and {b[0]} {show(p)} differ")
        return
    sys.stdout.writelines(difflib.unified_diff(*lines, f"{a[0]} {show(p)}", f"{b[0]} {show(p)}"))


def status(cfg, path=None):
    """Print the last sync result and the plan (or, with `path`, diffs for it); 1 if anything differs."""
    acts, want, _ = plan(cfg, read_written())
    if path:
        p = os.path.abspath(os.path.expanduser(path))
        hits = [a for a in acts if a[1] == p or under(a[1], p)]
        if not hits and not any(q == p or under(q, p) for q in want):
            raise Fail(f"{show(p)} is not managed by dot")
        for _, q, op, w in hits:
            if op in ("write", "delete"):
                diff(q, w)
        return 1 if any(a[2] for a in hits) else 0
    last = Path(STATE, "last")
    if last.exists():
        print("last sync:", last.read_text().strip())
    print_plan(acts)
    if not acts:
        print("up to date")
    return 1 if any(a[2] for a in acts) else 0


def take(cfg, path):
    """Copy a managed live file or folder back to its single source. Template destinations are refused
    with a diff against the render, and a missing live path is an error. Does not commit."""
    p = os.path.abspath(os.path.expanduser(path))
    want, roots = wants(cfg)
    hits = {q: w for q, w in want.items() if q == p or under(q, p)}
    if not hits:
        raise Fail(f"{show(p)} is not managed by dot")
    for q, w in hits.items():
        if w["template"]:
            diff(q, w, reverse=True)
            raise Fail(f"{show(q)} is rendered from {show(w['src'])}; edit the template instead", 1)
    root = max((r for r in roots if p == r[0] or under(p, r[0])), key=lambda r: len(r[0]), default=None)
    pairs = [(p, hits[p]["src"])] if p in hits and hits[p]["kind"] != "dir" else []
    if not pairs and root is None:
        raise Fail(f"{show(p)} holds several destinations; take them one at a time")
    if not pairs:
        dest, _, excl, src = root
        if not os.path.isdir(p):
            raise Fail(f"{show(p)} is not a folder" if os.path.lexists(p) else f"{show(p)} does not exist")
        for d, dirs, files in os.walk(p):
            links = [x for x in dirs if os.path.islink(os.path.join(d, x))]
            dirs[:] = [x for x in dirs if x not in links and not excluded(os.path.relpath(os.path.join(d, x), dest), excl)]
            pairs += [(os.path.join(d, x), os.path.join(src, os.path.relpath(os.path.join(d, x), dest)))
                      for x in files + links if not excluded(os.path.relpath(os.path.join(d, x), dest), excl)]
    for live, src in pairs:
        if not os.path.lexists(live):
            raise Fail(f"{show(live)} does not exist")
        w = want_of(live)
        if live_sig(src) != w["sig"]:
            if os.path.isdir(src) and not os.path.islink(src):
                raise Fail(f"cannot take {show(live)}: {show(src)} is a folder")
            write(src, w)
            print(f"took {show(live)} -> {show(src)}")
    return 0


def git(*args):
    """Run git in the setup folder without prompts, capped at 60 s; a timeout returns code 124."""
    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0",
           "GIT_SSH_COMMAND": "ssh -o BatchMode=yes -o ConnectTimeout=5"}
    try:
        return subprocess.run(["git", "-C", DOT, *args], capture_output=True, text=True, env=env, timeout=60)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(args, 124, "", "timed out after 60 s")
    except FileNotFoundError:
        raise Fail("git not found on PATH")


def sync():
    """Pull (fast-forward only), push when ahead and push is on, then apply without --force.
    Quiet on stdout; writes one line to .state/sync.log and .state/last. Never merges, rebases or
    resets. Exits quietly when another sync holds the lock."""
    os.makedirs(STATE, exist_ok=True)
    lock = open(os.path.join(STATE, "lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0
    notes, code = [], 0
    try:
        if not os.path.isdir(os.path.join(DOT, ".git")):
            raise Fail(f"{show(DOT)} is not a git repo")
        if git("status", "--porcelain", "--untracked-files=no").stdout.strip():
            raise Fail(f"refused: uncommitted changes in {show(DOT)} (commit or discard them)", 1)
        upstream = git("rev-parse", "--abbrev-ref", "@{u}").returncode == 0
        if not upstream:
            notes.append("no upstream")
        else:
            head = git("rev-parse", "HEAD").stdout
            r = git("pull", "--ff-only", "--quiet")
            notes.append(f"pull failed: {(r.stderr.strip().splitlines() or ['?'])[-1]}" if r.returncode
                         else "pulled" if git("rev-parse", "HEAD").stdout != head else "up to date")
        cfg = load()
        if upstream and cfg["push"] and git("rev-list", "--count", "@{u}..HEAD").stdout.strip() not in ("", "0"):
            r = git("push", "--quiet")
            notes.append(f"push failed: {(r.stderr.strip().splitlines() or ['?'])[-1]}" if r.returncode else "pushed")
        done, refused = apply(cfg)
        notes.append(f"{len(done)} changed")
        notes += [edited_note(p, op) for p, op in refused]
        code = 1 if refused else 0
    except Fail as e:
        notes.append(str(e).replace("\n", "; "))
        code = e.code
    line = f"{time.strftime('%Y-%m-%d %H:%M:%S')} {machine_name()} {'; '.join(notes)}"
    with open(os.path.join(STATE, "sync.log"), "a") as f:
        f.write(line + "\n")
    Path(STATE, "last").write_text(line + "\n")
    return code


def init(remote=None):
    """Create the setup folder: a clone of `remote`, or a new git repo from the bundled example."""
    if os.path.lexists(DOT):
        raise Fail(f"{show(DOT)} already exists")
    if remote:
        if subprocess.run(["git", "clone", "--quiet", remote, DOT]).returncode:
            raise Fail(f"could not clone {remote}")
        ignore = Path(DOT, ".gitignore")
        if ".state/" not in (ignore.read_text().split() if ignore.exists() else []):
            with open(os.path.join(DOT, ".git", "info", "exclude"), "a") as f:
                f.write("\n.state/\n")
    else:
        shutil.copytree(EXAMPLE, DOT, symlinks=True)
        subprocess.run(["git", "init", "--quiet", DOT], check=True)
        Path(DOT, ".gitignore").write_text(".state/\n")
    print(f"Created {show(DOT)}. Next: edit {show(DOT)}/dot.toml, run dot apply, then dot install.")
    return 0


def install(remove=False):
    """Install this machine's timer running `dot sync` every 15 minutes (systemd user timer on Linux,
    LaunchAgent on macOS), or with `remove`, unload and delete it. The timer keeps this shell's PATH
    and any DOT_HOME and DOT_MACHINE, so it syncs the same setup as the same machine."""
    cmd = [sys.executable, PROGRAM, "sync"]
    env = {"PATH": os.environ.get("PATH", ""), **({"DOT_HOME": DOT} if os.environ.get("DOT_HOME") else {}),
           **({"DOT_MACHINE": os.environ["DOT_MACHINE"]} if os.environ.get("DOT_MACHINE") else {})}

    def quote(s, dollar=False):
        """`s` as one double-quoted systemd value: C escapes, %% for a literal %, and $$ when `dollar`."""
        s = s.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n").replace("%", "%%")
        return '"' + (s.replace("$", "$$") if dollar else s) + '"'

    def run(*args, check=True):
        r = subprocess.run(args, capture_output=True, text=True)
        if check and r.returncode:
            raise Fail(f"{' '.join(args)} failed: {r.stderr.strip()}")
    if sys.platform == "darwin":
        plist, domain = os.path.join(HOME, "Library", "LaunchAgents", "dot.plist"), f"gui/{os.getuid()}"
        run("launchctl", "bootout", f"{domain}/dot", check=False)
        if remove:
            Path(plist).unlink(missing_ok=True)
            print("Removed the dot timer.")
            return 0
        os.makedirs(os.path.dirname(plist), exist_ok=True)
        os.makedirs(STATE, exist_ok=True)
        Path(plist).write_bytes(plistlib.dumps({
            "Label": "dot", "ProgramArguments": cmd, "RunAtLoad": True, "StartInterval": 900,
            "EnvironmentVariables": env, "StandardOutPath": os.path.join(STATE, "launchd.log"),
            "StandardErrorPath": os.path.join(STATE, "launchd.log")}))
        run("launchctl", "bootstrap", domain, plist)
    elif sys.platform.startswith("linux"):
        units = os.path.join(HOME, ".config", "systemd", "user")
        if remove:
            run("systemctl", "--user", "disable", "--now", "dot.timer", check=False)
            for name in ("dot.service", "dot.timer"):
                Path(units, name).unlink(missing_ok=True)
            run("systemctl", "--user", "daemon-reload", check=False)
            print("Removed the dot timer.")
            return 0
        os.makedirs(units, exist_ok=True)
        environment = "".join(f"Environment={quote(f'{k}={v}')}\n" for k, v in env.items())
        exec_start = " ".join(quote(c, dollar=True) for c in cmd)
        Path(units, "dot.service").write_text(
            f"[Unit]\nDescription=dot sync\n\n[Service]\nType=oneshot\n{environment}ExecStart={exec_start}\n")
        Path(units, "dot.timer").write_text(
            "[Unit]\nDescription=dot sync every 15 minutes\n\n[Timer]\nOnBootSec=2min\n"
            "OnUnitActiveSec=15min\nPersistent=true\n\n[Install]\nWantedBy=timers.target\n")
        run("systemctl", "--user", "daemon-reload")
        run("systemctl", "--user", "enable", "--now", "dot.timer")
    else:
        raise Fail(f"install supports Linux and macOS, not {sys.platform}")
    print(f"Installed: dot sync runs every 15 minutes on {machine_name()}.")
    return 0


def help_():
    """Print usage, then a summary of the live setup for agents: machine, values and sources."""
    print(USAGE)
    if not os.path.exists(os.path.join(DOT, "dot.toml")):
        print(f"\nNo setup at {show(DOT)} yet: run dot init.")
        return 0
    cfg, m = load(), machine_name()
    print(f"\nSetup {show(DOT)} on machine {m}.")
    names = list(dict.fromkeys([*cfg["values"], *(k for o in cfg["machines"].values() for k in o)]))
    if names:
        print("Values ({{name}} in templates, sources and destinations):")
    for k in names:
        print(f"  {k} = {values_for(cfg, m).get(k, '(unset here)')}")
        over = {mm: o[k] for mm, o in cfg["machines"].items() if k in o}
        if over:
            others = ", ".join(f"{mm}: {v}" for mm, v in over.items())
            print(f"    set per machine ({others}; base: {cfg['values'].get(k, 'unset')}): differs on purpose; do not unify")
    print("Sources (edit these in the setup, not the destinations):")
    for mp in cfg["maps"]:
        notes = [n for n, on in (("template", mp["template"]), ("mirror off", not mp["mirror"])) if on]
        notes += [f"only on {', '.join(mp['machines'])}"] if mp["machines"] is not None else []
        suffix = f"  ({'; '.join(notes)})" if notes else ""
        print(f"  {mp['src']} -> {', '.join(mp['to'])}{suffix}")
    return 0


def main(argv):
    """Dispatch a command line and return its exit code."""
    cmd, args = (argv[0], argv[1:]) if argv else ("status", [])
    if cmd in ("help", "-h", "--help"):
        return help_()
    if cmd == "init":
        return init(args[0] if args else None)
    if cmd == "sync":
        return sync()
    cfg = load()
    if cmd == "status":
        return status(cfg, args[0] if args else None)
    if cmd == "install":
        return install("--remove" in args)
    if cmd == "take":
        if len(args) != 1:
            raise Fail("usage: dot take <live-path>")
        return take(cfg, args[0])
    if cmd == "apply":
        if set(args) - {"-n", "--force"}:
            raise Fail(f"unknown option {sorted(set(args) - {'-n', '--force'})[0]} (dot apply [-n] [--force])")
        if "-n" in args:
            print_plan(plan(cfg, read_written())[0])
            return 0
        done, refused = apply(cfg, "--force" in args)
        print_plan(done)
        for p, op in refused:
            print(f"dot: {edited_note(p, op)}", file=sys.stderr)
        return 1 if refused else 0
    raise Fail(f"unknown command {cmd} (see dot help)")


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Fail as e:
        sys.stderr.write("".join(f"dot: {line}\n" for line in str(e).splitlines()))
        sys.exit(e.code)
