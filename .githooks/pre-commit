#!/bin/sh
# Keep commits honest: staged Go files must be gofmt-clean, and vet checks the tree the
# commit claims to be. The heavier gates (tests, guard, smoke) stay in ./x check on CI.
set -eu
staged=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.go$' || true)
[ -z "$staged" ] && exit 0
# shellcheck disable=SC2086 # one file per word, from git's newline-separated list
out=$(gofmt -l $staged)
if [ -n "$out" ]; then
    printf 'pre-commit: run gofmt -w on:\n%s\n' "$out" >&2
    exit 1
fi
go vet ./...
